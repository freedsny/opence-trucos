+/* port_config.c's: the cheats' settings (config.toml's [cheats], and the
+pause menu's SETTINGS, CHEATS) */
+int config_boolean(const char *name);
+unsigned long config_changes(void);
+
+/* port: a cheat that the player has on in the settings. Each is on for
+every tick of a game that is the player's own (not on a network: there the
+host's rules hold, cheats_network_client_enforce), put back each tick so
+that a map's scripts (b30's, around its cinematics) do not leave it off.
+Turning one off in the settings clears it once; while its setting is off,
+the console's and the maps' own use of the cheat is left alone */
+struct cheat_setting
+{
+	char const *name;
+	boolean *state;
+	boolean wanted;
+	boolean clear;
+};
+
+static struct cheat_setting cheat_settings[] =
+{
+	{ "cheats.infinite_ammo", &cheat.infinite_ammo, FALSE, FALSE },
+	{ "cheats.bottomless_clip", &cheat.bottomless_clip, FALSE, FALSE },
+	{ "cheats.super_jump", &cheat.super_jump, FALSE, FALSE },
+	{ "cheats.deathless_player", &cheat.deathless_player, FALSE, FALSE },
+	{ "cheats.omnipotent", &cheat.omnipotent, FALSE, FALSE },
+	{ "cheats.medusa", &cheat.medusa, FALSE, FALSE },
+	{ "cheats.jetpack", &cheat.jetpack, FALSE, FALSE },
+};
+
+#define NUMBER_OF_CHEAT_SETTINGS (sizeof(cheat_settings)/sizeof(cheat_settings[0]))
+
+/* the settings read again when one changed (config_changes), or when a map
+starts (force) */
+static unsigned long cheat_settings_changes = 0;
+static boolean cheat_settings_read = FALSE;
+
+static void cheats_settings_apply(
+	boolean force)
+{
+	unsigned long changes = config_changes();
+	boolean own_game = game_connection()==_game_connection_local && !network_game_distributed_client();
+	short index;
+
+	if (force || !cheat_settings_read || changes!=cheat_settings_changes)
+	{
+		cheat_settings_read = TRUE;
+		cheat_settings_changes = changes;
+		for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+		{
+			struct cheat_setting *setting = cheat_settings + index;
+			boolean wanted = config_boolean(setting->name)!=0;
+
+			if (setting->wanted && !wanted)
+				setting->clear = TRUE;
+			setting->wanted = wanted;
+		}
+	}
+
+	for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+	{
+		struct cheat_setting *setting = cheat_settings + index;
+
+		if (own_game)
+		{
+			if (setting->wanted)
+				*setting->state = TRUE;
+			else if (setting->clear)
+				*setting->state = FALSE;
+		}
+		setting->clear = FALSE;
+	}
+
+	return;
+}
+
